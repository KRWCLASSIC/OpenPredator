<Project>
  <PropertyGroup>
    <!-- Common build settings across all projects -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Metadata embedded into compiled PE binaries (Properties -> Details) -->
    <Authors>KRWCLASSIC</Authors>
    <Company>KRWCLASSIC</Company>
    <Product>OpenPredator</Product>
    <Description>High-performance, zero-bloat hardware control suite for Acer gaming laptops</Description>
    <Copyright>Copyright © 2026 KRWCLASSIC</Copyright>
    <PackageProjectUrl>https://github.com/KRWCLASSIC/OpenPredator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KRWCLASSIC/OpenPredator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.1</AssemblyVersion>
    <FileVersion>1.0.0.1</FileVersion>
    
    <!-- Centralized artifacts output -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).temp\artifacts</ArtifactsPath>

    <!-- Suppress known third-party COM reflection warnings from System.Management under NativeAOT -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>
</Project>
